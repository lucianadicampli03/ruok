# Copy this file to .env on the HP (same folder as README.md).
# Nothing here is required for the robot to roll and talk with Windows voice.

# Gemini — Greeter writes a fresh sentence from sensors + need
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ElevenLabs — human voice instead of Windows
# https://elevenlabs.io/app/settings/api-keys
# MLH usually hands out free codes at the event
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
